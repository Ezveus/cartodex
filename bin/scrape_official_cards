#!/usr/bin/env node
// Capture card pages from the official Pokémon card database, one HTML fragment per card.
//
// This is a one-off tool, run by hand, and it is deliberately the dumbest piece of the import:
// it navigates, slices out `section.card-detail`, and writes it. Every rule about what those
// bytes *mean* lives in Cards::OfficialParser, where it is covered by fixtures. Nothing here is
// unit-tested — this repository has no JS test infrastructure — so nothing here decides anything.
//
// Why a browser at all: www.pokemon.com sits behind Imperva. A plain HTTP client gets two or three
// requests and is then served a ~930-byte block page *with HTTP 200*, and the block sticks to the
// address for a while. A browser passes because it runs the challenge script, but its cookie does
// not transfer to another client — the token is bound to the TLS fingerprint too — and a fetch()
// from inside an already-validated page is refused as well, since Imperva separates
// `Sec-Fetch-Dest: document` from `empty` and that header cannot be set from script. Full
// navigation is the only thing that works, which is why this costs one page load per card.
//
// Why Node and raw CDP: selenium-webdriver is `group :test` in the Gemfile, and more to the point
// its automation flags are exactly what a WAF fingerprints. The Chrome that gets through is
// launched bare. Node ships a WebSocket, so CDP costs no dependency.
//
// Usage:
//   bin/scrape_official_cards --out tmp/official \
//     --gallery https://tcg.pokemon.com/assets/img/me-expansions/30th-celebration/cards/cards.json \
//     --set 30th:seeall --set 30th-c:classic-collection
//
// Re-running skips whatever is already on disk, so an abort costs only what it had not reached.

import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { spawn } from 'node:child_process';

const BASE = 'https://www.pokemon.com/us/pokemon-tcg/pokemon-cards/series';
const CHROME_CANDIDATES = [
  process.env.CHROME_PATH,
  '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
  '/usr/bin/google-chrome',
  '/usr/bin/chromium',
].filter(Boolean);

function parseArgs(argv) {
  const opts = { out: null, gallery: null, sets: [], throttle: 1000, port: 9339 };
  for (let i = 0; i < argv.length; i++) {
    const [k, v] = [argv[i], argv[i + 1]];
    if (k === '--out') { opts.out = v; i++; }
    else if (k === '--gallery') { opts.gallery = v; i++; }
    else if (k === '--set') { const [slug, bucket] = v.split(':'); opts.sets.push({ slug, bucket }); i++; }
    else if (k === '--throttle') { opts.throttle = Number(v); i++; }
    else if (k === '--port') { opts.port = Number(v); i++; }
    else { console.error(`unknown argument: ${k}`); process.exit(2); }
  }
  if (!opts.out || !opts.gallery || opts.sets.length === 0) {
    console.error('usage: bin/scrape_official_cards --out DIR --gallery URL --set SLUG:BUCKET [--set …]');
    process.exit(2);
  }
  return opts;
}

const sleep = ms => new Promise(r => setTimeout(r, ms));

function launchChrome(port) {
  const bin = CHROME_CANDIDATES.find(p => fs.existsSync(p));
  if (!bin) { console.error('no Chrome found; set CHROME_PATH'); process.exit(2); }
  const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'scrape-official-'));
  const child = spawn(bin, [
    '--headless=new', '--disable-gpu', '--no-first-run', '--no-default-browser-check',
    `--remote-debugging-port=${port}`, `--user-data-dir=${profile}`, 'about:blank',
  ], { stdio: 'ignore' });
  return { child, profile };
}

async function connect(port) {
  for (let i = 0; i < 30; i++) {
    try {
      const t = await (await fetch(`http://127.0.0.1:${port}/json/new?about:blank`, { method: 'PUT' })).json();
      const ws = new WebSocket(t.webSocketDebuggerUrl);
      await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; });
      let id = 0;
      const pending = new Map();
      ws.onmessage = e => {
        const m = JSON.parse(e.data);
        if (!m.id || !pending.has(m.id)) return;
        const { res, rej } = pending.get(m.id);
        pending.delete(m.id);
        m.error ? rej(new Error(m.error.message)) : res(m.result);
      };
      const send = (method, params = {}) => new Promise((res, rej) => {
        const i = ++id;
        pending.set(i, { res, rej });
        ws.send(JSON.stringify({ id: i, method, params }));
      });
      await send('Page.enable');
      return send;
    } catch { await sleep(500); }
  }
  console.error('could not attach to Chrome');
  process.exit(1);
}

// Returns the fragment, or null with a reason. The guard is the presence of the card markup and
// not the HTTP status: the block page is served as 200, so a status check would accept it.
async function capture(send, url) {
  const evaluate = async expression => {
    try {
      const r = await send('Runtime.evaluate', { expression, returnByValue: true });
      return r.result?.value;
    } catch { return undefined; } // the execution context is destroyed mid-navigation
  };
  await send('Page.navigate', { url });
  for (let i = 0; i < 40; i++) {
    await sleep(500);
    const html = await evaluate(
      'document.querySelector(".card-detail") && document.querySelector(".card-description")' +
      ' ? document.querySelector(".card-detail").outerHTML : ""'
    );
    if (html) return { html };
  }
  return { html: null, title: await evaluate('document.title'), size: await evaluate('document.documentElement.outerHTML.length') };
}

const opts = parseArgs(process.argv.slice(2));
fs.mkdirSync(opts.out, { recursive: true });

const gallery = await (await fetch(opts.gallery)).json();
const jobs = opts.sets.flatMap(({ slug, bucket }) => {
  const numbers = gallery[bucket];
  if (!Array.isArray(numbers)) { console.error(`gallery has no bucket "${bucket}"`); process.exit(2); }
  return numbers.map(n => ({ slug, n }));
});
console.log(`${jobs.length} card(s) to capture into ${opts.out}`);

const { child, profile } = launchChrome(opts.port);
const cleanup = () => {
  try { child.kill(); } catch {}
  try { fs.rmSync(profile, { recursive: true, force: true }); } catch {}
};
process.on('exit', cleanup);
process.on('SIGINT', () => { cleanup(); process.exit(130); });

const send = await connect(opts.port);

let written = 0, skipped = 0, consecutiveFailures = 0;
const failures = [];

for (const { slug, n } of jobs) {
  const target = path.join(opts.out, `${slug}_${n}.html`);
  if (fs.existsSync(target) && fs.statSync(target).size > 512) { skipped++; continue; }

  const url = `${BASE}/${slug}/${n}/`;
  let result = await capture(send, url);
  if (!result.html) {
    await sleep(3000);
    result = await capture(send, url);
  }

  if (!result.html) {
    failures.push(`${slug}/${n} (title=${JSON.stringify(result.title)} size=${result.size})`);
    console.error(`FAILED ${slug}/${n} — title=${JSON.stringify(result.title)} size=${result.size}`);
    // Three in a row is the source refusing us, not three odd cards. Stopping is the point:
    // the block page is a 200, so carrying on would fill the directory with pages that look
    // like successes and fail only at import, 180 requests later.
    if (++consecutiveFailures >= 3) { console.error('three consecutive failures — stopping'); break; }
    continue;
  }

  consecutiveFailures = 0;
  fs.writeFileSync(target, result.html + '\n');
  written++;
  if (written % 20 === 0) console.log(`  … ${written} written, ${skipped} already present`);
  await sleep(opts.throttle);
}

console.log(`\nwritten=${written} skipped=${skipped} failed=${failures.length} of ${jobs.length}`);
if (failures.length) {
  console.log('failed:');
  for (const f of failures) console.log(`  ${f}`);
}
process.exit(failures.length ? 1 : 0);
